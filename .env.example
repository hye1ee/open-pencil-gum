# Copy to .env (gitignored) to override locally.

# Controls which "create element" tools the AI agent gets in CORE_TOOLS
# (packages/core/src/tools/registry-core.ts).
#   true  (default) - only the JSX `render` tool
#   false            - per-element create_rectangle/create_frame/create_ellipse/
#                       create_text/create_polygon/create_star/create_line tools,
#                       `render` excluded
VITE_RENDER=false

# Hybrid canvas vision: inject a bounded canvas PNG into each agent step so the
# model sees the overall layout cheaply (src/app/ai/chat/canvas-vision.ts).
#   true (default) - image injected each step
#   false          - no image; run a task both ways to compare cost-log.txt
VITE_CANVAS_VISION=true

# Ask the model for a reasoning summary and write it to agent-log.txt as THINK
# lines, interleaved with the tool calls it led to (src/app/ai/chat/model-trace.ts).
#
# VITE_MODEL_TASK only. Every other slot is asked NOT to think — they answer a
# rubric with a short list, and on Gemini thinking is charged to the same output
# budget as the answer.
#
# First-party Anthropic and Google only. OpenRouter forwards neither, and the
# meta-agent only ever sees the reasoning, so on OpenRouter it raises nothing.
#   false (default) - no reasoning requested
#   true            - THINK lines in the run log
VITE_AI_THINKING=false


# ── Which model each AI calls (src/app/ai/model-routing.ts) ──────────────────
#
# Format is `provider:model`, split at the FIRST colon (an OpenRouter model ID
# can contain one of its own). Valid providers are the ids in AI_PROVIDERS:
# openrouter, anthropic, openai, google, deepseek, zai, minimax,
# openai-compatible, anthropic-compatible.
#
# Leave a line empty and that slot falls back to VITE_MODEL_DEFAULT; leave that
# empty too and it uses whatever is selected in the app's settings panel. With
# every line below empty the app behaves exactly as it did before this existed.
#
# Each run writes the resolved table to agent-log.txt as a ROUTING block, with
# where each line came from — read that rather than guessing.

VITE_MODEL_DEFAULT=

# The design agent itself.
VITE_MODEL_TASK=
# Turns the request into a directive and reconciles it after a user edit. Small
# summarising calls, so this is the place inside the agent worth pointing at a
# cheaper model.
VITE_MODEL_TASK_PLANNING=

# Reads six screenshots every thirty seconds. Needs vision, and is the most
# expensive thing here by volume.
VITE_MODEL_USER_MODEL_PROPOSE=
# Places what those screenshots said into the model. Text only, same timer.
VITE_MODEL_USER_MODEL_REVISE=
# Runs when a person answers (or ignores) a marker: what they changed, and why
# they wanted it. Rare, and the best evidence the model gets.
VITE_MODEL_FEEDBACK=

# Judges the agent's reasoning against the user model, once per chunk of
# thinking. Worth pointing at a different model from VITE_MODEL_TASK — a judge
# sharing the subject's blind spots agrees for the same wrong reasons.
VITE_MODEL_META_AGENT=


# ── API keys ─────────────────────────────────────────────────────────────────
#
# Per provider, so slots on different providers each find their own. A provider
# left empty here falls back to the key typed into the settings panel.

VITE_API_KEY_OPENROUTER=
VITE_API_KEY_ANTHROPIC=
VITE_API_KEY_OPENAI=
VITE_API_KEY_GOOGLE=
VITE_API_KEY_DEEPSEEK=
VITE_API_KEY_ZAI=
VITE_API_KEY_MINIMAX=

# The two compatible providers need a base URL as well as a key. This is also
# how to reach a model that has no first-party provider here — point them at a
# gateway (LiteLLM, Bedrock Access Gateway) and set the slot to
# `openai-compatible:<the gateway's model id>`.
VITE_API_KEY_OPENAI_COMPATIBLE=
VITE_BASE_URL_OPENAI_COMPATIBLE=
VITE_API_KEY_ANTHROPIC_COMPATIBLE=
VITE_BASE_URL_ANTHROPIC_COMPATIBLE=

# Embeddings for the user model's retrieval step (src/app/user-model/pipeline.ts).
# Always OpenAI, whatever the slots above are set to. Without it the user model
# stays off — capture still writes frames to disk, but nothing is inferred, since
# retrieval is what stops every batch from creating duplicates.
VITE_OPENAI_API_KEY=
