# Copy to .env (gitignored) to override locally.

# true (default) gives the agent only the JSX `render` tool; false swaps it for
# the per-element create_rectangle/create_frame/… set (packages/core registry).
VITE_RENDER=false

# Inject a bounded canvas PNG into each agent step so the model sees the layout
# cheaply (src/app/ai/chat/canvas-vision.ts). Default true.
VITE_CANVAS_VISION=true

# Reasoning summaries as THINK lines in agent-log.txt (model-trace.ts). Applies
# to VITE_MODEL_TASK only, and only on first-party Anthropic and Google.
VITE_AI_THINKING=false
VITE_FEEDBACK_NOTE_EXPERIMENT=false
VITE_USER_MODEL_FIXTURE=false


# ── Which model each AI calls (src/app/ai/model-routing.ts) ──────────────────
#
# `provider:model`, split at the FIRST colon. Providers are the AI_PROVIDERS ids:
# openrouter, anthropic, openai, google, deepseek, zai, minimax,
# openai-compatible, anthropic-compatible.
#
# An empty line falls back to VITE_MODEL_DEFAULT, then to the settings panel.
# Each run writes the resolved table to agent-log.txt as a ROUTING block.

VITE_MODEL_DEFAULT=

# The design agent itself.
VITE_MODEL_TASK=
# Writes the directive and reconciles it after a user edit. Small summarising
# calls — the one place inside the agent worth a cheaper model.
VITE_MODEL_TASK_PLANNING=

# Six screenshots every thirty seconds. Needs vision, most expensive by volume.
VITE_MODEL_USER_MODEL_PROPOSE=
# Places what those screenshots said into the model. Text only, same timer.
VITE_MODEL_USER_MODEL_REVISE=
# Runs when someone answers or ignores a marker. Rare, and the best evidence.
VITE_MODEL_FEEDBACK=
VITE_MODEL_FEEDBACK_DRAFT=anthropic:claude-haiku-4-5

# Judges the agent's completed reasoning, once per step. Worth a different model from
# VITE_MODEL_TASK: a judge sharing the subject's blind spots agrees wrongly.
VITE_MODEL_META_AGENT=

# Dev-only shadow analysis. Extracts task-agent propositions from each completed
# reasoning block, links them to the user model, and writes META-GRAPH entries to
# agent-log.txt without changing marks, notes, or task-agent execution.
VITE_META_COMPARISON_SHADOW=false


# ── API keys ─────────────────────────────────────────────────────────────────
#
# Per provider. Empty falls back to the key typed into the settings panel.

VITE_API_KEY_OPENROUTER=
VITE_API_KEY_ANTHROPIC=
VITE_API_KEY_OPENAI=
VITE_API_KEY_GOOGLE=
VITE_API_KEY_DEEPSEEK=
VITE_API_KEY_ZAI=
VITE_API_KEY_MINIMAX=

# The compatible providers also need a base URL. This is how to reach a model
# with no first-party provider here — point them at a gateway and set the slot
# to `openai-compatible:<the gateway's model id>`.
VITE_API_KEY_OPENAI_COMPATIBLE=
VITE_BASE_URL_OPENAI_COMPATIBLE=
VITE_API_KEY_ANTHROPIC_COMPATIBLE=
VITE_BASE_URL_ANTHROPIC_COMPATIBLE=

# Embeddings for the user model's retrieval step. Always OpenAI. Without it the
# user model stays off: frames are still written, but nothing is inferred.
VITE_OPENAI_API_KEY=
